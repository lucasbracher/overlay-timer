#: src/cli.c:77
#, c-format
msgid "Usage: %s [options]\n"
msgstr "Uso: %s [opções]\n"

#: src/cli.c:79
#, c-format
msgid ""
"\n"
"Translucent, click-through countdown/pomodoro overlay timer.\n"
"\n"
"Time / mode:\n"
"  -t, --time <MM:SS|HH:MM:SS>  start a countdown\n"
"      --pomodoro <N>           start N pomodoros\n"
"      --sync                   with --pomodoro: align cycles with the clock\n"
"                               (:00 and :30 with the default 25+5 min)\n"
"      --format <hhmmss|mmss>   display format (actual time takes "
"precedence)\n"
"\n"
"Appearance:\n"
"  -c, --color <color>          text color (name or #RRGGBB)\n"
"      --alpha <0-100>          visibility (0=transparent, 100=opaque)\n"
"      --size <0-100>           text size as %% of the screen's smaller side\n"
"      --font <family>          font family\n"
"      --corner <tl|tr|bl|br>   corner\n"
"      --screen <idx[,idx...]>  screen index(es)\n"
"\n"
"Pomodoro:\n"
"      --pomodoro-minutes <m>\n"
"      --break-minutes <m>\n"
"      --long-break-minutes <m>\n"
"      --long-break-every <N>   0 = no long break (default)\n"
"      --pomodoro-color <color>\n"
"      --break-color <color>\n"
"\n"
"Control (requires a running timer):\n"
"      --pause | --resume | --stop\n"
"\n"
"Audio:\n"
"      --sounds-dir <path>      directory with .wav files\n"
"      --sound | --no-sound     enable/disable sound\n"
"\n"
"Window system:\n"
"      --x11 | --wayland\n"
"\n"
"Config:\n"
"      --config <path>          use an alternate config file\n"
"      --save                   merge current options into the config file\n"
"\n"
"General:\n"
"  -h, --help\n"
"  -V, --version\n"
msgstr ""
"\n"
"Timer de overlay translúcido e click-through (countdown/pomodoro).\n"
"\n"
"Tempo / modo:\n"
"  -t, --time <MM:SS|HH:MM:SS>  inicia uma contagem regressiva\n"
"      --pomodoro <N>           inicia N pomodoros\n"
"      --sync                   com --pomodoro: alinha os ciclos com o relógio\n"
"                               (:00 e :30 com o padrão de 25+5 min)\n"
"      --format <hhmmss|mmss>   formato de exibição (o tempo informado tem "
"precedência)\n"
"\n"
"Aparência:\n"
"  -c, --color <cor>            cor do texto (nome ou #RRGGBB)\n"
"      --alpha <0-100>          visibilidade (0=transparente, 100=opaco)\n"
"      --size <0-100>           tamanho do texto em %% da menor dimensão da "
"tela\n"
"      --font <família>         família da fonte\n"
"      --corner <tl|tr|bl|br>   canto\n"
"      --screen <idx[,idx...]>  índice(s) de tela\n"
"\n"
"Pomodoro:\n"
"      --pomodoro-minutes <m>\n"
"      --break-minutes <m>\n"
"      --long-break-minutes <m>\n"
"      --long-break-every <N>   0 = sem pausa longa (padrão)\n"
"      --pomodoro-color <cor>\n"
"      --break-color <cor>\n"
"\n"
"Controle (requer um timer em execução):\n"
"      --pause | --resume | --stop\n"
"\n"
"Áudio:\n"
"      --sounds-dir <caminho>   diretório com arquivos .wav\n"
"      --sound | --no-sound     ativa/desativa som\n"
"\n"
"Sistema de janelas:\n"
"      --x11 | --wayland\n"
"\n"
"Configuração:\n"
"      --config <caminho>       usa um arquivo de configuração alternativo\n"
"      --save                   mescla as opções atuais no arquivo de "
"configuração\n"
"\n"
"Geral:\n"
"  -h, --help\n"
"  -V, --version\n"

